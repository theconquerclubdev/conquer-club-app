# Copy this file to ".env" and fill in your real values.
# NEVER commit the real .env file or share the service_role key anywhere.

# Found in Supabase Dashboard -> Project Settings -> API -> Project URL
SUPABASE_URL=https://your-project-ref.supabase.co

# Found in Supabase Dashboard -> Project Settings -> API -> service_role key
# This key bypasses Row Level Security - keep it secret, local-machine only.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Optional - defaults to "progress-photos" if not set
SUPABASE_BUCKET=progress-photos
